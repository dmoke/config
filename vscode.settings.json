{
  "workbench.editorAssociations": {
    "*.vjs_c": "default",
  },
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "files.autoSave": "afterDelay",
  "workbench.iconTheme": "material-icon-theme",
  "editor.lineHeight": 0.9,

  // Formatters
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.formatOnSave": true,

  // Python formatting
  "python.formatting.provider": "black",
  "python.formatting.blackArgs": ["--line-length", "88"],

  // Terminal
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "ms-settings",
  ],
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.initialHint": false,
  "terminal.integrated.tabs.defaultColor": "terminal.ansiCyan",

  // Git / Copilot
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "typescript": true,
  },
  "git.enableSmartCommit": true,

  // VSCode layout
  "workbench.activityBar.location": "top",
  "workbench.colorCustomizations": {
    "[Default Dark Modern]": {
      "terminal.background": "#000000",
      "editor.background": "#141615",
      "editorGroup.border": "#ffffff17",
      "sideBar.background": "#000000",
      "list.activeSelectionBackground": "#333b7270",
      "list.inactiveSelectionBackground": "#333b7270",
      "list.inactiveFocusOutline": "#eb32d6",
      "panel.background": "#000000",
      "commandCenter.background": "#0000006f",
      "editorGroupHeader.tabsBackground": "#000000",
      "tab.activeBackground": "#070b2a",
    },
  },

  // Editor tweaks
  "editor.padding.top": 100,
  "editor.inlayHints.padding": true,
  "editor.minimap.size": "fill",
  "editor.aiStats.enabled": false,
  "editor.defaultFormatter": null,

  // Spell / lint
  "cSpell.enabled": false,
  "cSpell.checkVSCodeSystemFiles": true,
  "cSpell.maxDuplicateProblems": 1,
  "cSpell.userWords": ["esbenp", "testuser"],
  "cSpell.ignoreRegExpList": ["/\\b[A-Z]+\\b/"],

  // Extensions tweaks
  "vim.disableExtension": true,
  "playwright.reuseBrowser": true,
  "eslint.format.enable": false,
  "workbench.editor.empty.hint": "hidden",
  "playwright.pickLocatorCopyToClipboard": false,
  "chat.editing.confirmEditRequestRemoval": false,
  "editor.codeLens": false,
  "explorer.confirmDelete": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "git.confirmSync": false
}
